# Neon Postgres (`neon env pull` fills these into .env.local)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Auth.js: generate with `npx auth secret` or any 32-byte base64 string
AUTH_SECRET=""

# Neon Object Storage, "media" bucket (`neon deploy` / `neon env pull` fill these)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_ENDPOINT_URL_S3="https://br-xxx.storage.c-x.region.aws.neon.tech"
AWS_REGION="eu-central-1"

# Optional: Google sign-in
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Optional: Discord sign-in + role sync (one Discord application for both)
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""
DISCORD_BOT_TOKEN=""

# Local test account used during development (not a real user)
TEST_USER_EMAIL="test@pazaar.test"
TEST_USER_PASSWORD="Deneme1234"
